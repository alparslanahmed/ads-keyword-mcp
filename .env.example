# Google Ads API credentials (keep server-side; never commit real values).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

DATABASE_DSN=keyword_market.db
LOG_LEVEL=info
APP_ENV=development

KEYWORD_PLANNING_RATE_LIMIT_RPS=1
CACHE_KEYWORD_IDEAS_DAYS=7
CACHE_HISTORICAL_METRICS_DAYS=30

MCP_SERVER_NAME=keyword-market
MCP_SERVER_VERSION=0.1.0

# Optional: run without credentials using deterministic mock data.
# GOOGLE_ADS_MOCK=true

# Optional: override the Google Ads REST API version (default v18).
# GOOGLE_ADS_API_VERSION=v18

# Optional: HTTP debug server port (default 8080).
# HTTP_PORT=8080

# Optional: protects /debug/* endpoints when APP_ENV is not "development".
# DEBUG_API_KEY=
